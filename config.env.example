# AI-IDE Bridge Configuration Example
# Copy this file to .env and configure as needed

# ==================== Server Configuration ====================

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Enable debug mode (set to false in production)
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==================== Workspace Configuration ====================

# Default workspace root (can be overridden via API)
WORKSPACE_ROOT=/home/user/projects/my-project

# Project type (python, odoo, nodejs, java, cpp, other)
PROJECT_TYPE=python

# Excluded directories (comma-separated)
EXCLUDED_DIRS=node_modules,__pycache__,.git,venv,env,.venv,dist,build

# ==================== AI Provider Configuration ====================

# Primary AI provider (claude, chatgpt, gemini)
AI_PROVIDER=claude

# Enable fallback providers
ENABLE_FALLBACK=true

# Fallback order (comma-separated)
FALLBACK_PROVIDERS=chatgpt,gemini

# ==================== Browser Automation ====================

# Run browser in headless mode
HEADLESS=true

# Browser executable path (leave empty for default)
BROWSER_PATH=

# Session persistence directory
SESSION_DIR=./sessions

# Auto-save sessions
AUTO_SAVE_SESSIONS=true

# Session timeout (hours)
SESSION_TIMEOUT=24

# ==================== Security ====================

# API key for authentication (recommended for production)
# Generate with: openssl rand -hex 32
API_KEY=

# Enable CORS (set allowed origins or * for all)
CORS_ORIGINS=*

# Maximum file size (bytes) - 10MB default
MAX_FILE_SIZE=10485760

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.java,.cpp,.c,.h,.xml,.json,.yaml,.yml,.md,.txt

# Command execution whitelist (comma-separated, empty = use blacklist)
ALLOWED_COMMANDS=

# Command execution blacklist (comma-separated)
BLOCKED_COMMANDS=rm -rf,dd if=,mkfs,chmod -R 777,wget,curl

# ==================== Performance ====================

# Enable response caching
ENABLE_CACHE=true

# Cache size (number of entries)
CACHE_SIZE=100

# Cache TTL (minutes)
CACHE_TTL=60

# Request timeout (seconds)
REQUEST_TIMEOUT=180

# Rate limit (requests per minute)
RATE_LIMIT=20

# ==================== Features ====================

# Enable automatic code analysis
AUTO_ANALYZE=false

# Enable diagnostic integration
ENABLE_DIAGNOSTICS=true

# Enable WebSocket for real-time updates
ENABLE_WEBSOCKET=true

# Enable metrics endpoint (Prometheus)
ENABLE_METRICS=false

# ==================== Odoo-Specific Configuration ====================
# (Only relevant if PROJECT_TYPE=odoo)

# Odoo version
ODOO_VERSION=16.0

# Odoo addons path
ODOO_ADDONS_PATH=/opt/odoo/addons

# Enable Odoo-specific tools
ENABLE_ODOO_TOOLS=true

# ==================== OCR-Specific Configuration ====================
# (If working with OCR systems)

# OCR engine (tesseract, easyocr, paddleocr)
OCR_ENGINE=tesseract

# OCR language
OCR_LANG=eng

# Enable OCR-specific assistance
ENABLE_OCR_TOOLS=false

# ==================== Monitoring & Logging ====================

# Log file path
LOG_FILE=./logs/ai-bridge.log

# Log rotation (max size in MB)
LOG_MAX_SIZE=10

# Log backup count
LOG_BACKUP_COUNT=5

# Enable request logging
LOG_REQUESTS=true

# Enable response logging (may contain sensitive data)
LOG_RESPONSES=false

# ==================== Advanced ====================

# Number of browser instances (for parallel processing)
BROWSER_INSTANCES=1

# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Custom prompts directory
CUSTOM_PROMPTS_DIR=./prompts

# Model routing configuration file
MODEL_ROUTING_CONFIG=./config/model_routing.json

# ==================== VS Code Extension Settings ====================
# (Configure in VS Code settings.json)

# {
#   "ai-assistant.serverUrl": "http://localhost:8000",
#   "ai-assistant.autoAnalyze": false,
#   "ai-assistant.projectType": "python",
#   "ai-assistant.apiKey": "your-api-key",
#   "ai-assistant.enableDiagnostics": true,
#   "ai-assistant.cacheResponses": true
# }

# ==================== Production Deployment ====================

# For production, also consider:
# - Using HTTPS (reverse proxy)
# - Setting up firewall rules
# - Implementing rate limiting per user
# - Using a process manager (systemd, supervisord)
# - Setting up monitoring (Prometheus, Grafana)
# - Configuring log aggregation (ELK, Loki)

# Example systemd service:
# sudo systemctl enable ai-bridge
# sudo systemctl start ai-bridge

# Example nginx reverse proxy:
# server {
#     listen 443 ssl;
#     server_name ai.yourdomain.com;
#     location / {
#         proxy_pass http://localhost:8000;
#     }
# }

# ==================== Docker Configuration ====================

# Docker-specific environment variables
# DOCKER_NETWORK=bridge
# DOCKER_VOLUME_WORKSPACE=/workspace
# DOCKER_VOLUME_SESSIONS=/sessions

# ==================== Troubleshooting ====================

# Enable verbose logging for debugging
# VERBOSE_LOGGING=true

# Disable headless mode to see browser (for debugging auth issues)
# HEADLESS=false

# Increase timeouts if experiencing timeout errors
# REQUEST_TIMEOUT=300
# SESSION_TIMEOUT=48

# Clear cache and sessions if experiencing issues
# rm -rf ./sessions/*
# rm -rf ./cache/*
